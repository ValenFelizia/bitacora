{
  "$schema": "../node_modules/@tauri-apps/cli/config.schema.json",
  "productName": "Bitácora",
  "version": "0.1.0",
  "identifier": "com.valenfelizia.bitacora",
  "build": {
    "beforeBuildCommand": "npm run prepare:installer",
    "frontendDist": "splash"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": "default-src 'none'; style-src 'unsafe-inline'; script-src 'self'"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": { "payload/runtime/": "runtime/" },
    "windows": {
      "webviewInstallMode": { "type": "downloadBootstrapper", "silent": true },
      "nsis": {
        "languages": ["Spanish"],
        "installMode": "currentUser"
      }
    }
  }
}
